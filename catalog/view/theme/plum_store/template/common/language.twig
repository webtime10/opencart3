{% if languages %}
{% set current_label = code|default('ua')|split('-')|first|upper %}
<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-language" class="topbar-dd" data-dropdown>
  <button type="button" class="topbar-dd-btn" aria-expanded="false" aria-haspopup="listbox">
    <span class="topbar-dd-label" data-dd-label>{{ current_label }}</span>
    <svg class="icon icon-chevron" aria-hidden="true"><use href="catalog/view/theme/plum_store/image/icons.svg#i-chevron"></use></svg>
  </button>
  {% if languages|length > 1 %}
  <ul class="topbar-dd-menu" role="listbox">
    {% for language in languages %}
    {% set item_label = language.code|split('-')|first|upper %}
    <li>
      <button type="button" class="topbar-dd-item language-select{% if language.code == code %} is-active{% endif %}" name="{{ language.code }}" data-value="{{ language.code }}" data-label="{{ item_label }}" title="{{ language.name }}">{{ item_label }}</button>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  <input type="hidden" name="code" value=""/>
  <input type="hidden" name="redirect" value="{{ redirect }}"/>
</form>
{% endif %}
