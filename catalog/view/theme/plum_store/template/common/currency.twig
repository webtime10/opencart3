{% if currencies %}
<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-currency" class="topbar-dd" data-dropdown>
  <button type="button" class="topbar-dd-btn" aria-expanded="false"{% if currencies|length > 1 %} aria-haspopup="listbox"{% endif %}>
    <span class="topbar-dd-label" data-dd-label>{{ code }}</span>
    {% if currencies|length > 1 %}
    <svg class="icon icon-chevron" aria-hidden="true"><use href="catalog/view/theme/plum_store/image/icons.svg#i-chevron"></use></svg>
    {% endif %}
  </button>
  {% if currencies|length > 1 %}
  <ul class="topbar-dd-menu" role="listbox">
    {% for currency in currencies %}
    <li>
      <button type="button" class="topbar-dd-item currency-select{% if currency.code == code %} is-active{% endif %}" name="{{ currency.code }}" data-value="{{ currency.code }}" data-label="{{ currency.code }}" title="{{ currency.title }}">{{ currency.code }}</button>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  <input type="hidden" name="code" value=""/>
  <input type="hidden" name="redirect" value="{{ redirect }}"/>
</form>
{% endif %}
