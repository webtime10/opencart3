{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header wt-exchange-page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-wt-general" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button>
        <a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid wt-exchange-container">
    {% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
    <h4>{{ heading_title }}</h4>
    <p class="wt-exchange-main-menu">{% for item in top_menu %}<a href="{{ item.url }}" class="btn btn-info{% if item.active %} active{% endif %}">{{ item.text }}</a>{% endfor %}</p>
    <div class="panel panel-default">
      <div class="panel-body">
        <ul class="nav nav-tabs">
          <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general_settings }}</a></li>
        </ul>
        <div class="tab-content">
          <div class="tab-pane active" id="tab-general">
            <p class="help-block">{{ text_help_general }}</p>
            <form action="{{ action }}" method="post" id="form-wt-general" class="form-horizontal">
              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_import_ajax }}</label>
                <div class="col-sm-9">
                  <select name="import_mode_ajax" class="form-control">
                    <option value="1"{% if import_mode_ajax %} selected{% endif %}>{{ text_yes }}</option>
                    <option value="0"{% if not import_mode_ajax %} selected{% endif %}>{{ text_no }}</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_ajax_timeout }}</label>
                <div class="col-sm-9">
                  <input type="text" name="ajax_timeout" value="{{ ajax_timeout }}" class="form-control" />
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_workdir }}</label>
                <div class="col-sm-9">
                  <input type="text" name="workdir" value="{{ workdir }}" class="form-control" />
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_product_log }}</label>
                <div class="col-sm-9">
                  <select name="product_log" class="form-control">
                    <option value="0"{% if not product_log %} selected{% endif %}>{{ text_no }}</option>
                    <option value="1"{% if product_log %} selected{% endif %}>{{ text_yes }}</option>
                  </select>
                </div>
              </div>
              <hr />
              <h4>{{ entry_profile_name }}</h4>
              <p class="help-block">{{ text_profiles_help }}</p>
              {% if profiles %}
              <ul class="list-group" style="max-width:600px">
                {% for profile in profiles %}
                <li class="list-group-item">{{ profile.name }} <small class="text-muted">({{ profile.entity }} / {{ profile.type }})</small></li>
                {% endfor %}
              </ul>
              {% endif %}
              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_profile_name }}</label>
                <div class="col-sm-4"><input type="text" name="profile_name" value="" class="form-control" placeholder="My export profile" /></div>
                <div class="col-sm-2"><select name="profile_entity" class="form-control"><option value="product">product</option><option value="category">category</option><option value="customer">customer</option><option value="order">order</option></select></div>
                <div class="col-sm-2"><select name="profile_type" class="form-control"><option value="export">export</option><option value="import">import</option></select></div>
              </div>
              <input type="hidden" name="profile_data" value="" />
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>.wt-exchange-main-menu a{margin:0 4px 6px 0}</style>
{{ footer }}
