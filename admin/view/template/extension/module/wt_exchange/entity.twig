{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header wt-exchange-page-header">
    <div class="container-fluid">
      <div class="pull-right">
        {% if tab != 'import' or not wt_exchange_job_id %}
        <button type="submit" form="form-wt-entity" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button>
        {% endif %}
        {% if tab == 'export' %}
        <a href="{{ export_run }}&format=csv" class="btn btn-info">{{ button_export }} CSV</a>
        <a href="{{ export_run }}&format=xml" class="btn btn-info">{{ button_export }} XML</a>
        <a href="{{ export_run }}&format=json" class="btn btn-info">{{ button_export }} JSON</a>
        <a href="{{ export_run }}&format=xlsx" class="btn btn-info">{{ button_export }} XLSX</a>
        {% endif %}
        <a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }} — {{ entity_title }}</h1>
    </div>
  </div>
  <div class="container-fluid wt-exchange-container">
    {% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
    <p class="wt-exchange-main-menu">{% for item in top_menu %}<a href="{{ item.url }}" class="btn btn-info{% if item.active %} active{% endif %}">{{ item.text }}</a>{% endfor %}</p>
    <div class="panel panel-default"><div class="panel-body">
      <ul class="nav nav-tabs">
        {% for key, item in entity_tabs %}
        <li{% if tab == key %} class="active"{% endif %}><a href="{{ item.href }}">{{ item.text }}</a></li>
        {% endfor %}
      </ul>
      <div style="margin-top:15px">
        {% if tab == 'fields' %}
        <form action="{{ action }}" method="post" id="form-wt-entity">
          <p>{{ text_fields_help }}</p>
          <table class="table table-bordered">
            <thead><tr><th>{{ entry_field_code }}</th><th>{{ entry_csv_name }}</th></tr></thead>
            <tbody>
            {% for field in field_list %}
            <tr><td>{{ field.label }} ({{ field.code }})</td><td><input type="text" name="entity_mappings[{{ field.code }}]" value="{{ field.csv_name }}" class="form-control input-sm" /></td></tr>
            {% endfor %}
            </tbody>
          </table>
        </form>
        {% elseif tab == 'export' %}
        <form action="{{ action }}" method="post" id="form-wt-entity" class="form-horizontal">
          <div class="row">
            <div class="col-sm-5">
              <div class="form-group"><label class="col-sm-4 control-label">{{ entry_languages }}</label><div class="col-sm-8"><select name="language_id" class="form-control">{% for language in languages %}<option value="{{ language.language_id }}"{% if export_language_id == language.language_id %} selected{% endif %}>{{ language.name }}</option>{% endfor %}</select></div></div>
              <div class="form-group"><label class="col-sm-4 control-label">{{ entry_encoding }}</label><div class="col-sm-8"><select name="encoding" class="form-control">{% for code, label in encodings %}<option value="{{ code }}"{% if encoding == code %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div></div>
              <div class="form-group"><label class="col-sm-4 control-label">{{ entry_delimiter }}</label><div class="col-sm-8"><select name="delimiter" class="form-control"><option value=";"{% if delimiter == ';' %} selected{% endif %}>;</option><option value=","{% if delimiter == ',' %} selected{% endif %}>,</option></select></div></div>
              <div class="form-group"><label class="col-sm-4 control-label">{{ entry_format }}</label><div class="col-sm-8"><select name="format" class="form-control"><option value="csv"{% if format == 'csv' %} selected{% endif %}>CSV</option><option value="xml"{% if format == 'xml' %} selected{% endif %}>XML</option><option value="json"{% if format == 'json' %} selected{% endif %}>JSON</option><option value="xlsx"{% if format == 'xlsx' %} selected{% endif %}>XLSX</option></select></div></div>
              {% if entity == 'category' %}
              <div class="form-group"><label class="col-sm-4 control-label">{{ entry_parent_id }}</label><div class="col-sm-8"><input type="text" name="parent_id" value="{{ export_filter_parent_id }}" class="form-control" /></div></div>
              <div class="form-group"><label class="col-sm-4 control-label">{{ entry_status }}</label><div class="col-sm-8"><select name="status" class="form-control"><option value="">—</option><option value="1"{% if export_filter_status == '1' %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if export_filter_status == '0' %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
              {% endif %}
              {% if entity == 'customer' %}
              <div class="form-group"><label class="col-sm-4 control-label">{{ entry_customer_group }}</label><div class="col-sm-8"><select name="customer_group_id" class="form-control"><option value="0">—</option>{% for g in customer_groups %}<option value="{{ g.customer_group_id }}"{% if export_filter_customer_group_id == g.customer_group_id %} selected{% endif %}>{{ g.name }}</option>{% endfor %}</select></div></div>
              {% endif %}
              {% if entity == 'order' %}
              <div class="form-group"><label class="col-sm-4 control-label">{{ entry_order_status }}</label><div class="col-sm-8"><select name="order_status_id" class="form-control"><option value="0">—</option>{% for s in order_statuses %}<option value="{{ s.order_status_id }}"{% if export_filter_order_status_id == s.order_status_id %} selected{% endif %}>{{ s.name }}</option>{% endfor %}</select></div></div>
              <div class="form-group"><label class="col-sm-4 control-label">{{ entry_date_from }}</label><div class="col-sm-8"><input type="date" name="date_from" value="{{ export_filter_date_from }}" class="form-control" /></div></div>
              <div class="form-group"><label class="col-sm-4 control-label">{{ entry_date_to }}</label><div class="col-sm-8"><input type="date" name="date_to" value="{{ export_filter_date_to }}" class="form-control" /></div></div>
              {% endif %}
            </div>
            <div class="col-sm-7"><div class="wt-exchange-field-list">{% for field in field_list %}<div class="checkbox"><label><input class="wt-field-cb" type="checkbox" name="fields[]" value="{{ field.code }}"{% if field.selected %} checked{% endif %} /> {{ field.label }} ({{ field.code }})</label></div>{% endfor %}</div></div>
          </div>
        </form>
        {% else %}
        {% if order_import_only %}<div class="alert alert-info">{{ text_order_import_note }}</div>{% endif %}
        <form action="{{ action }}" method="post" id="form-wt-entity" class="form-horizontal" style="margin-bottom:20px">
          <div class="form-group"><label class="col-sm-2 control-label">{{ entry_languages }}</label><div class="col-sm-4"><select name="language_id" class="form-control">{% for language in languages %}<option value="{{ language.language_id }}"{% if import_language_id == language.language_id %} selected{% endif %}>{{ language.name }}</option>{% endfor %}</select></div></div>
          <div class="form-group"><label class="col-sm-2 control-label">{{ entry_encoding }}</label><div class="col-sm-4"><select name="encoding" class="form-control">{% for code, label in encodings %}<option value="{{ code }}"{% if import_encoding == code %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div></div>
          {% if not order_import_only %}<div class="form-group"><label class="col-sm-2 control-label">{{ entry_mode }}</label><div class="col-sm-4"><select name="mode" class="form-control">{% for code, label in import_modes %}<option value="{{ code }}"{% if import_mode == code %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div></div>{% endif %}
          <div class="form-group"><label class="col-sm-2 control-label">{{ entry_key }}</label><div class="col-sm-4"><select name="key" class="form-control">{% for code, label in key_options %}<option value="{{ code }}"{% if import_key == code %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div></div>
        </form>
        <div id="wt-import-progress" style="display:none;margin-bottom:15px"><div class="progress"><div class="progress-bar" style="width:0">0%</div></div><p id="wt-import-status">{{ text_import_progress }}</p></div>
        <form action="{{ import_run }}" method="post" enctype="multipart/form-data"><div class="form-group"><label class="col-sm-2 control-label">{{ entry_file }}</label><div class="col-sm-6"><input type="file" name="import_file" accept=".csv,.json,.xml,.xlsx" /></div><div class="col-sm-4"><button type="submit" class="btn btn-primary">{{ button_import }}</button></div></div></form>
        {% endif %}
      </div>
    </div></div>
  </div>
</div>
<style>.wt-exchange-main-menu a{margin:0 4px 6px 0}.wt-exchange-field-list{max-height:420px;overflow:auto;border:1px solid #ddd;padding:10px}</style>
{% if tab == 'import' and wt_exchange_job_id %}
<script type="text/javascript"><!--
(function(){
  var stepUrl = '{{ import_step }}&job_id={{ wt_exchange_job_id }}&batch=25';
  $('#wt-import-progress').show();
  function runStep(){ $.getJSON(stepUrl, function(json){ if(json.error){ $('#wt-import-status').text(json.error); return; } var pct = json.total ? Math.round(json.offset/json.total*100) : 100; $('#wt-import-progress .progress-bar').css('width', pct+'%').text(pct+'%'); $('#wt-import-status').text('Updated: '+json.updated+', inserted: '+json.inserted+', skipped: '+json.skipped); if(!json.finished) setTimeout(runStep, 500); }); }
  runStep();
})();
//--></script>
{% endif %}
{{ footer }}
